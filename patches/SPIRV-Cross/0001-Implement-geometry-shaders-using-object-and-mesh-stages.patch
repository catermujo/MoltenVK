+		end_scope();
+		statement("if (!primitiveValid)");
+		begin_scope();
+		statement("meshGridProperties.set_threadgroups_per_grid(uint3(0, 1, 1));");
+		statement("return;");
+		end_scope();
+
+		statement("meshGridProperties.set_threadgroups_per_grid(uint3(", std::to_string(msl_options.geometry_invocations), ", 1, 1));");
+
+		end_scope();
+	} else {
+		assert(execution.model == ExecutionModelGeometry);
+		auto payload_member_name = [](const MSLShaderInterfaceVariable &variable) {
+			if (variable.builtin != BuiltInMax)
+				return join("builtin", std::to_string(variable.builtin));
+			return join("in", std::to_string(variable.location));
+		};
+
+		auto find_payload_variable = [&](bool builtin, uint32_t value) -> const MSLShaderInterfaceVariable * {
+			if (builtin) {
+				auto it = inputs_by_builtin.find(value);
+				return it == inputs_by_builtin.end() ? nullptr : &it->second;
+			}
+
+			LocationComponentPair key;
+			key.location = value;
+			key.component = 0;
+			auto it = inputs_by_location.find(key);
+			return it == inputs_by_location.end() ? nullptr : &it->second;
+		};
+
+		// Emit the payload struct
+		statement("struct Payload");
+		begin_scope();
+		statement("struct payload_vertex");
