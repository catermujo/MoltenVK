+void CompilerMSL::emit_mesh_wrapper() {
+	auto &execution = get_entry_point();
+
+	if (execution.model == ExecutionModelVertex) {
+		const bool has_stage_output = stage_out_var_id != 0;
+		auto out_var_type = has_stage_output ? get_variable_data_type(get<SPIRVariable>(stage_out_var_id)) : get<SPIRType>(get_uint_type_id());
+
+		// Emit the payload struct
+		statement("struct Payload");
+		begin_scope();
+		statement("uint32_t primitive_id;");
+		if (has_stage_output)
+			statement(join(type_to_glsl(out_var_type), " vertices[", std::to_string(vertex_count_in_primitive(msl_options.input_primitive_type)), "];"));
+		end_scope(";");
+
+		// Emit struct with info about the draw call.
+		statement("struct DrawInfo");
+		begin_scope();
+
+		statement("int32_t indexed;");
+		statement("int32_t indexSize;");
+		statement("int64_t indexBuffer;");
+		statement("int32_t vertexOffset;");
+		statement("uint32_t firstVertex;");
+		statement("uint32_t firstInstance;");
+		statement("uint32_t primitiveRestart;");
+
+		end_scope(";");
+
+		// Object entry point.
+		statement("[[object]]  void ", execution.name, "(object_data Payload &payload [[payload]], mesh_grid_properties meshGridProperties, constant DrawInfo *drawInfo [[buffer(", std::to_string(get_msl_options().draw_info_index),")]],");
+
+		bool vertex_bindings[32] = {false};
+		for (auto si: inputs_by_location) {
+			if (si.second.builtin != BuiltInMax) continue;
+			vertex_bindings[si.second.binding] = true;
+		}
+
+		for (int i = 0; i < 32; ++i) {
+			if (!vertex_bindings[i]) continue;
+			std::string binding = std::to_string(i);
+			statement("device uchar *vb", binding, " [[buffer(", binding, ")]],");
+		}
+
+		// Disable for_mesh_pipeline temporarily so that args get their [[attributes]].
+		msl_options.for_mesh_pipeline = false;
+		string object_arguments;
+		if (msl_options.argument_buffers)
+			object_arguments = entry_point_args_argument_buffer(false, false, false, false);
+		else
+			entry_point_args_discrete_descriptors(object_arguments);
+		msl_options.for_mesh_pipeline = true;
+
+		if (!object_arguments.empty()) object_arguments += ",";
+		statement(object_arguments);
+
+		statement("uint3 positionInGrid [[threadgroup_position_in_grid]]",
+		          msl_options.input_primitive_type == CompilerMSL::Options::PrimitiveTopology::TriangleStripAdjacency ?
+		          ", uint3 threadgroupsPerGrid [[threadgroups_per_grid]]" : "", ")");
+
+		begin_scope();
+
+		statement("int startingIndex = positionInGrid.x * ", primitive_topology_is_list(msl_options.input_primitive_type) ? std::to_string(vertex_count_in_primitive(msl_options.input_primitive_type)) : std::to_string(primitive_topology_stride(msl_options.input_primitive_type)), ";");
+		statement("int vertexCount = ", vertex_count_in_primitive(msl_options.input_primitive_type), ";");
+		statement("bool primitiveValid = true;");
+
+		statement("int instanceIndex = positionInGrid.y + drawInfo->firstInstance;");
+
+		statement("for (int i = 0; i < vertexCount; ++i)");
+		begin_scope();
+		statement("uint vertexIndex;");
+		statement("int indexOffset = ", msl_options.input_primitive_type == CompilerMSL::Options::PrimitiveTopology::TriangleFan ? "(i == 0 ? 0 : positionInGrid.x + i)" : "startingIndex + i", ";");
+		if (msl_options.input_primitive_type == CompilerMSL::Options::PrimitiveTopology::TriangleStripAdjacency) {
+			statement("if (threadgroupsPerGrid.x > 1)");
+			begin_scope();
+			statement("if (positionInGrid.x == 0)");
+			begin_scope();
+			statement("switch (i)");
+			begin_scope();
+			statement("case 0: indexOffset = 0; break;");
+			statement("case 1: indexOffset = 1; break;");
+			statement("case 2: indexOffset = 2; break;");
+			statement("case 3: indexOffset = 6; break;");
+			statement("case 4: indexOffset = 4; break;");
+			statement("case 5: indexOffset = 3; break;");
+			end_scope();
+			end_scope();
+			statement("else if ((positionInGrid.x & 1) != 0)");
+			begin_scope();
+			statement("switch (i)");
+			begin_scope();
+			statement("case 0: indexOffset = startingIndex + 2; break;");
+			statement("case 1: indexOffset = startingIndex - 2; break;");
+			statement("case 2: indexOffset = startingIndex; break;");
+			statement("case 3: indexOffset = startingIndex + 3; break;");
+			statement("case 4: indexOffset = startingIndex + 4; break;");
+			statement("case 5: indexOffset = startingIndex + (positionInGrid.x == int(threadgroupsPerGrid.x) - 1 ? 5 : 6); break;");
+			end_scope();
+			end_scope();
+			statement("else");
+			begin_scope();
+			statement("switch (i)");
+			begin_scope();
+			statement("case 0: indexOffset = startingIndex; break;");
+			statement("case 1: indexOffset = startingIndex - 2; break;");
+			statement("case 2: indexOffset = startingIndex + 2; break;");
+			statement("case 3: indexOffset = startingIndex + (positionInGrid.x == int(threadgroupsPerGrid.x) - 1 ? 5 : 6); break;");
+			statement("case 4: indexOffset = startingIndex + 4; break;");
+			statement("case 5: indexOffset = startingIndex + 3; break;");
+			end_scope();
+			end_scope();
+			end_scope();
+		}
+
+		statement("if (drawInfo->indexed)");
+		begin_scope();
+
+		statement(R"END(
+		if (drawInfo->indexSize == 1) {
+			vertexIndex = ((constant uchar *)drawInfo->indexBuffer)[indexOffset + drawInfo->firstVertex];
+		} else if (drawInfo->indexSize == 2) {
+			vertexIndex = ((constant ushort *)drawInfo->indexBuffer)[indexOffset + drawInfo->firstVertex];
+		} else {
+			vertexIndex = ((constant uint *)drawInfo->indexBuffer)[indexOffset + drawInfo->firstVertex];
+		})END");
+
+		end_scope();
+		if (msl_options.input_primitive_type == CompilerMSL::Options::PrimitiveTopology::TriangleFan)
+			statement("else vertexIndex = (i == 0 ? 0 : positionInGrid.x + i) + drawInfo->firstVertex;");
+		else if (msl_options.input_primitive_type == CompilerMSL::Options::PrimitiveTopology::TriangleStripAdjacency)
+			statement("else vertexIndex = indexOffset + drawInfo->firstVertex;");
+		else
+			statement("else vertexIndex = startingIndex + i + drawInfo->firstVertex;");
+		statement(R"END(
+		if (drawInfo->primitiveRestart && drawInfo->indexed) {
+			if ((drawInfo->indexSize == 1 && vertexIndex == 0xffu) ||
+			    (drawInfo->indexSize == 2 && vertexIndex == 0xffffu) ||
+			    (drawInfo->indexSize == 4 && vertexIndex == 0xffffffffu))
+				primitiveValid = false;
+		})END");
+		statement("if (drawInfo->indexed) vertexIndex += drawInfo->vertexOffset;");
+
+		if (stage_in_var_id) {
+			auto in_var_type = get_variable_data_type(get<SPIRVariable>(stage_in_var_id));
+			statement(type_to_glsl(in_var_type), " ", to_name(stage_in_var_id), ";");
+		}
+
+		ir.for_each_typed_id<SPIRVariable>([&](uint32_t id, SPIRVariable &var) {
+			if (var.storage != StorageClassInput)
+				return;
+
+			auto &type = get<SPIRType>(var.basetype);
+			if (has_decoration(type.self, DecorationBlock))
+				return;
+
+			if (!interface_variable_exists_in_entry_point(var.self))
+				return;
+
+			if (is_hidden_variable(var, true))
+				return;
+
+			if (is_builtin_variable(var))
+				return;
+
+			uint32_t location = get_decoration(id, DecorationLocation);
+
+			LocationComponentPair key;
+			key.location  = location;
+			key.component = 0;
+
+			auto payload_it = inputs_by_location.find(key);
+			if (payload_it == inputs_by_location.end())
+				return;
+
+			auto variable = payload_it->second;
+			std::string name = to_name(id);
+
+			SPIRType& parent_type = get<SPIRType>(type.parent_type);
+			std::string parent_type_str = type_to_glsl(get<SPIRType>(type.parent_type), var.self);
+			uint32_t load_elements = std::min<uint32_t>(variable.vecsize, parent_type.vecsize);
+			const char *index_name = variable.rate == MSL_SHADER_VARIABLE_RATE_PER_PRIMITIVE ? "instanceIndex" : "vertexIndex";
+
+			std::string type_name = get_variable_format_string(variable.format);
+			std::string component = type_name + get_vertex_loader_component_suffix(load_elements);
+			std::string packed = variable.vecsize > 1 ? "packed_" : "";
+			std::string load_string = "*(device " + packed + component + " *)(vb" + std::to_string(variable.binding) + " + " + std::to_string(variable.offset) + " + " + index_name + " * " + std::to_string(variable.stride) + ")";
+			if (load_elements != parent_type.vecsize) {
+				component = type_name + get_vertex_loader_component_suffix(parent_type.vecsize);
+				load_string = component + "(" + load_string;
+				for (uint32_t i = load_elements; i < parent_type.vecsize; i++)
+					load_string += (i == 3) ? ", 1" : ", 0";
+				load_string += ")";
+			}
+			if (parent_type_str != component)
+				load_string = parent_type_str + "(" + load_string + ")";
+			statement(to_name(var.self), " = ", load_string, get_normalization_string(variable.format, variable.normalized), ";");
+		});
+
+		statement(has_stage_output ? "payload.vertices[i] = " : "", execution.name, "(");
+		bool need_semicolon = false;
+		if (stage_in_var_id) {
+			need_semicolon = true;
+			statement(to_name(stage_in_var_id));
+		}
+
+		if (msl_options.argument_buffers) {
+			for (uint32_t i = 0; i < kMaxArgumentBuffers; ++i) {
+				if (!argument_buffer_ids[i]) continue;
