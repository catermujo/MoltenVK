+static int vertex_count_in_primitive(CompilerMSL::Options::PrimitiveTopology top) {
+	switch (top) {
+		case CompilerMSL::Options::PrimitiveTopology::Points:
+			return 1;
+		case CompilerMSL::Options::PrimitiveTopology::Lines:
+		case CompilerMSL::Options::PrimitiveTopology::LineStrip:
+			return 2;
+		case CompilerMSL::Options::PrimitiveTopology::TriangleFan:
+			return 3;
+		case CompilerMSL::Options::PrimitiveTopology::LinesAdjacency:
+		case CompilerMSL::Options::PrimitiveTopology::LineStripAdjacency:
+			return 4;
+		case CompilerMSL::Options::PrimitiveTopology::Triangles:
+		case CompilerMSL::Options::PrimitiveTopology::TriangleStrip:
+			return 3;
+		case CompilerMSL::Options::PrimitiveTopology::TrianglesAdjacency:
+		case CompilerMSL::Options::PrimitiveTopology::TriangleStripAdjacency:
+			return 6;
+	}
+	return 1;
+}
+
+static int primitive_topology_stride(CompilerMSL::Options::PrimitiveTopology top) {
+	switch (top) {
+	case CompilerMSL::Options::PrimitiveTopology::LineStripAdjacency:
+			return 1;
+		case CompilerMSL::Options::PrimitiveTopology::TriangleStripAdjacency:
+			return 2;
+		default:
+			return 1;
+	}
+}
+
+static bool primitive_topology_is_list(CompilerMSL::Options::PrimitiveTopology top) {
+	switch (top) {
+		case CompilerMSL::Options::PrimitiveTopology::Lines:
+		case CompilerMSL::Options::PrimitiveTopology::LinesAdjacency:
+		case CompilerMSL::Options::PrimitiveTopology::Triangles:
+		case CompilerMSL::Options::PrimitiveTopology::TrianglesAdjacency:
+			return true;
+		default:
+			return false;
+	}
+}
+
+static const char* geometry_output_topology(const SPIREntryPoint& execution) {
+	if (execution.flags.get(ExecutionModeOutputPoints)) {
+		return "point";
+	}
+	if (execution.flags.get(ExecutionModeOutputLineStrip) || execution.flags.get(ExecutionModeOutputLinesEXT)) {
+		return "line";
+	}
+	if (execution.flags.get(ExecutionModeOutputTriangleStrip) || execution.flags.get(ExecutionModeOutputTrianglesEXT)) {
+		return "triangle";
+	}
+	SPIRV_CROSS_THROW("Geometry shader output primitive type not supported");
+}
+
+static bool geometry_output_is_strip(const SPIREntryPoint& execution) {
+	return execution.flags.get(ExecutionModeOutputLineStrip) || execution.flags.get(ExecutionModeOutputTriangleStrip);
+}
+
+static uint32_t geometry_output_primitive_count(const SPIREntryPoint& execution) {
+	uint32_t vertices_per_primitive = 3;
+	if (execution.flags.get(ExecutionModeOutputPoints)) {
+		vertices_per_primitive = 1;
+	} else if (execution.flags.get(ExecutionModeOutputLineStrip) || execution.flags.get(ExecutionModeOutputLinesEXT)) {
+		vertices_per_primitive = 2;
+	}
+	if (execution.output_vertices < vertices_per_primitive)
+		return 1;
+	return execution.output_vertices - vertices_per_primitive + 1;
+}
+
+static const char* get_vertex_loader_component_suffix(uint32_t elements) {
+	switch (elements) {
+		case 1: return "";
+		case 2: return "2";
+		case 3: return "3";
+		case 4: return "4";
+		default:
+			SPIRV_CROSS_THROW("Invalid component count: " + std::to_string(elements));
+			return "INVALID_COMPONENT_COUNT";
+	}
+}
+
+static const char* get_normalization_string(MSLShaderVariableFormat type, bool normalized) {
+	if (!normalized)
+		return "";
+	switch (type) {
+		case MSL_SHADER_VARIABLE_FORMAT_UINT16: return " * (1.f/65535.f)";
+		case MSL_SHADER_VARIABLE_FORMAT_UINT8:  return " * (1.f/255.f)";
+		// TODO: Proper positive sint normalization
+		case MSL_SHADER_VARIABLE_FORMAT_INT16: return " * (1.f/32768.f)";
+		case MSL_SHADER_VARIABLE_FORMAT_INT8:  return " * (1.f/128.f)";
+		default: return "";
+	}
+}
+
+static const char *get_variable_format_string(MSLShaderVariableFormat format) {
+	switch (format) {
+		case MSL_SHADER_VARIABLE_FORMAT_INT8: return "byte";
+		case MSL_SHADER_VARIABLE_FORMAT_UINT8: return "ubyte";
+		case MSL_SHADER_VARIABLE_FORMAT_INT16: return "short";
+		case MSL_SHADER_VARIABLE_FORMAT_UINT16: return "ushort";
+		case MSL_SHADER_VARIABLE_FORMAT_INT32: return "int";
+		case MSL_SHADER_VARIABLE_FORMAT_UINT32: return "uint";
+		case MSL_SHADER_VARIABLE_FORMAT_HALF: return "half";
+		case MSL_SHADER_VARIABLE_FORMAT_FLOAT: return "float";
+		default:
+			SPIRV_CROSS_THROW("Format not handled: " + std::to_string(format));
+			return "INVALID_TYPE";
+	}
+}
+
+static const char *get_variable_format_string(SPIRType::BaseType type) {
+	switch (type) {
+		case SPIRType::SByte: return "byte";
+		case SPIRType::UByte: return "ubyte";
+		case SPIRType::Short: return "short";
+		case SPIRType::UShort: return "ushort";
+		case SPIRType::Int: return "int";
+		case SPIRType::UInt: return "uint";
+		case SPIRType::Int64: return "long";
+		case SPIRType::UInt64: return "ulong";
+		case SPIRType::Half: return "half";
+		case SPIRType::Float: return "float";
+		case SPIRType::Double: return "double";
+		default:
+			SPIRV_CROSS_THROW("Type not handled: " + std::to_string(type));
+			return "INVALID_TYPE";
+	}
+}
