+	return 1;
+}
+
+static bool primitive_topology_is_list(CompilerMSL::Options::PrimitiveTopology top) {
+	switch (top) {
+		case CompilerMSL::Options::PrimitiveTopology::Lines:
+		case CompilerMSL::Options::PrimitiveTopology::LinesAdjacency:
+		case CompilerMSL::Options::PrimitiveTopology::Triangles:
+		case CompilerMSL::Options::PrimitiveTopology::TrianglesAdjacency:
+			return true;
+		default:
+			return false;
+	}
+}
+
+static const char* geometry_output_topology(const SPIREntryPoint& execution) {
+	if (execution.flags.get(ExecutionModeOutputPoints)) {
+		return "point";
+	}
+	if (execution.flags.get(ExecutionModeOutputLineStrip) || execution.flags.get(ExecutionModeOutputLinesEXT)) {
+		return "line";
+	}
+	if (execution.flags.get(ExecutionModeOutputTriangleStrip) || execution.flags.get(ExecutionModeOutputTrianglesEXT)) {
+		return "triangle";
+	}
+	SPIRV_CROSS_THROW("Geometry shader output primitive type not supported");
+}
+
+static uint32_t geometry_output_primitive_count(const SPIREntryPoint& execution) {
+	uint32_t vertices_per_primitive = 3;
+	if (execution.flags.get(ExecutionModeOutputPoints)) {
+		vertices_per_primitive = 1;
+	} else if (execution.flags.get(ExecutionModeOutputLineStrip) || execution.flags.get(ExecutionModeOutputLinesEXT)) {
+		vertices_per_primitive = 2;
+	}
+	return std::max(1u, execution.output_vertices - vertices_per_primitive + 1);
 }
 
